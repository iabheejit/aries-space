# Satellite and ground-station configuration
NORAD_ID=68635
SATELLITE_NAME=CANVAS
STATION_NAME=GHRCE campus (approx.)
STATION_LAT=21.1052484
STATION_LON=79.0034903
STATION_ELEV_M=310

# Storage credentials: replace for any shared environment.
POSTGRES_DB=aries
POSTGRES_USER=aries
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_PORT=5432
MINIO_ACCESS_KEY=aries
MINIO_SECRET_KEY=replace-with-a-random-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_BEARER_TOKEN=replace-with-a-random-64-character-token

# Offline by default. Empty this value and recreate app for the gated live check.
SATNOGS_FIXTURE_PATH=/app/services/api/aries_api/fixtures/satnogs_observation_14790266.json

# Polling
TLE_REFRESH_HOURS=12
OBS_POLL_MINUTES=10
SATNOGS_MAX_RESPONSE_BYTES=10000000
READINESS_TIMEOUT_SECONDS=2
SCHEDULER_ENABLED=false

# Benchmark assumptions. These are configurable model inputs, not market claims.
DOWNLINK_MBPS=100
ELECTRICITY_INR_PER_KWH=8
DOWNLINK_INR_PER_GB=500
GROUND_COMPUTE_INR_PER_HOUR=100
GROUND_ESTIMATED_WATTS=25
EDGE_SIM_WATTS=15
EDGE_SIM_SLOWDOWN_FACTOR=4
EDGE_MEASURED_WATTS=8
# TCO fix: amortized edge hardware cost, charged alongside electricity so
# edge is not modeled as free compute. Defaults: a space/edge-qualified AI
# accelerator card at ~INR 300,000 CAPEX, amortized over 5 years continuous
# operation (43,800 hours) -> ~INR 6.85/hour.
EDGE_HARDWARE_CAPEX_INR=300000
EDGE_HARDWARE_LIFETIME_HOURS=43800
BENCHMARK_TIMEOUT_SECONDS=10
BENCHMARK_SAMPLE_ITERATIONS=1000
SENTINEL2_BENCHMARK_SAMPLE_ITERATIONS=15

# Sentinel-2 L2A crop source (AWS Open Data, no-sign-request). Real low-cloud
# scene over the GHRCE/Nagpur agricultural region. Offline by default (like
# SATNOGS_FIXTURE_PATH above) via Compose's SENTINEL2_FIXTURE_PATH default.
# Empty SENTINEL2_FIXTURE_PATH and recreate app for the gated live fetch.
SENTINEL2_ITEM_ID=S2C_43QHD_20260619_0_L2A
SENTINEL2_RED_HREF=https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/43/Q/HD/2026/6/S2C_43QHD_20260619_0_L2A/B04.tif
SENTINEL2_NIR_HREF=https://sentinel-cogs.s3.us-west-2.amazonaws.com/sentinel-s2-l2a-cogs/43/Q/HD/2026/6/S2C_43QHD_20260619_0_L2A/B08.tif
SENTINEL2_OBSERVED_AT=2026-06-19T05:33:00.760000+00:00
SENTINEL2_CROP_COL_OFF=5000
SENTINEL2_CROP_ROW_OFF=5000
SENTINEL2_CROP_WIDTH=1024
SENTINEL2_CROP_HEIGHT=1024
SENTINEL2_FETCH_TIMEOUT_SECONDS=20

# Coastal/JNPT scene (ship-detect's AOI) crop window -- same pattern as
# the agricultural crop above, defaults to a 1024x1024 window.
SENTINEL2_COASTAL_CROP_COL_OFF=0
SENTINEL2_COASTAL_CROP_ROW_OFF=0
SENTINEL2_COASTAL_CROP_WIDTH=1024
SENTINEL2_COASTAL_CROP_HEIGHT=1024

# Compose publishes only to localhost by default.
PORT=8000