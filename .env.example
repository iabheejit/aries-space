# Satellite and ground-station configuration
NORAD_ID=68635
SATELLITE_NAME=CANVAS
STATION_NAME=GHRCE campus (approx.)
STATION_LAT=21.1052484
STATION_LON=79.0034903
STATION_ELEV_M=310

# Storage credentials: replace for any shared environment.
POSTGRES_DB=aries
POSTGRES_USER=aries
POSTGRES_PASSWORD=replace-with-a-random-postgres-password
POSTGRES_PORT=5432
MINIO_ACCESS_KEY=aries
MINIO_SECRET_KEY=replace-with-a-random-minio-password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
API_BEARER_TOKEN=replace-with-a-random-64-character-token

# Offline by default. Empty this value and recreate app for the gated live check.
SATNOGS_FIXTURE_PATH=/app/services/api/aries_api/fixtures/satnogs_observation_14790266.json

# Polling
TLE_REFRESH_HOURS=12
OBS_POLL_MINUTES=10
SATNOGS_MAX_RESPONSE_BYTES=10000000
READINESS_TIMEOUT_SECONDS=2
SCHEDULER_ENABLED=false

# Benchmark assumptions. These are configurable model inputs, not market claims.
DOWNLINK_MBPS=100
ELECTRICITY_INR_PER_KWH=8
DOWNLINK_INR_PER_GB=500
GROUND_COMPUTE_INR_PER_HOUR=100
GROUND_ESTIMATED_WATTS=25
EDGE_SIM_WATTS=15
EDGE_SIM_SLOWDOWN_FACTOR=4
BENCHMARK_TIMEOUT_SECONDS=10
BENCHMARK_SAMPLE_ITERATIONS=1000

# Compose publishes only to localhost by default.
PORT=8000